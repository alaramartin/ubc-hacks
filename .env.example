# Arc testnet RPC used by the agent, sellers and scripts: the QuickNode endpoint with its token,
# https://<name>.arc-testnet.quiknode.pro/<token>/ (the public RPC also works)
ARC_RPC_URL=
ARC_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
QUICKNODE_ARC_RPC_URL=
QUICKNODE_ARC_TOKEN=
QUICKNODE_API_KEY=

# Role wallets (generate with: cast wallet new)
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
AGENT_KEY=
AGENT_ADDRESS=
SELLER_HONEST_KEY=
SELLER_HONEST_ADDRESS=
SELLER_CHEAP_KEY=
SELLER_CHEAP_ADDRESS=

# Indexer and receipts (the deployed web app), used by the agent
INDEXER_URL=
RECEIPTS_URL=

# Shared secret for the Stream webhook HMAC (at least 32 chars); also set in Vercel
QN_STREAM_SECRET=
