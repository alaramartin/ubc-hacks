# Arc testnet RPC (public RPC works; the QuickNode endpoint is faster)
ARC_RPC_URL=https://rpc.testnet.arc.network
QUICKNODE_ARC_RPC_URL=
QUICKNODE_API_KEY=

# Role wallets (generate with: cast wallet new)
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
AGENT_KEY=
AGENT_ADDRESS=
SELLER_HONEST_KEY=
SELLER_HONEST_ADDRESS=
SELLER_CHEAP_KEY=
SELLER_CHEAP_ADDRESS=

# Indexer and receipts (the deployed web app), used by the agent
INDEXER_URL=
RECEIPTS_URL=

# Shared secret for the Stream webhook HMAC (at least 32 chars); also set in Vercel
QN_STREAM_SECRET=
